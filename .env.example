# Example environment variables for ai-masa project
# Copy this file to .env and fill in your actual API keys.

# Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
export GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY_HERE


# OpenAI API Key
export OPENAI_API_KEY="sk-..."


# Opencode config.json
export OPENCODE_CONFIG_PATH=${PWD}/config/opencode/config.json


# Shared Dir
export SHARED_DIR=${PWD}/works/shared
